# =============================================================================
# AI Academic Recovery & Course Progress Agent - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Primary Database (PostgreSQL / SQLite fallback)
# In production (Render/Railway), use the hosted PostgreSQL connection string.
# Render/Railway postgres:// prefixes are automatically converted to postgresql://.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academic_recovery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=academic_recovery
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# ChromaDB Vector Store & Knowledge Base
# CHROMA_PATH: Absolute or relative directory path for local persistent vector store.
# CHROMA_DB_URL: HTTP URL to ChromaDB container or remote instance.
# CHROMA_HOST_PORT: Host-mapped port for Docker Chroma container (default: 8001).
# -----------------------------------------------------------------------------
CHROMA_PATH=./chroma_data
CHROMA_DB_URL=http://localhost:8001
CHROMA_HOST_PORT=8001

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=supersecretjwtkey_change_in_production

# -----------------------------------------------------------------------------
# SMTP Email Notification Credentials
# Leave SMTP_SERVER empty in dev to safely log notifications to console.
# -----------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@vignan.ac.in
SMTP_PASSWORD=app_specific_password_here

# -----------------------------------------------------------------------------
# External Academic System Integrations
# -----------------------------------------------------------------------------
ATTENDANCE_SYSTEM_URL=http://localhost:9001
LESSON_PLAN_SYSTEM_URL=http://localhost:9002

# -----------------------------------------------------------------------------
# AI Services & LLM Provider
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Frontend Configuration (Client-side accessible)
# In production, set to your backend public domain (e.g., https://api.yourdomain.com)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
