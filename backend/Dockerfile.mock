# Lightweight Dockerfile for Mock External Systems
FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn pydantic

COPY mock_services /app/mock_services

ENV PYTHONUNBUFFERED=1

EXPOSE 9001 9002

CMD ["uvicorn", "mock_services.mock_attendance_system:app", "--host", "0.0.0.0", "--port", "9001"]
